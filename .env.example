# Stripe dashboard -> Developers -> API keys (use sk_test_... while testing)
STRIPE_SECRET_KEY=sk_test_xxx
# Stripe dashboard -> Developers -> Webhooks -> your endpoint -> Signing secret
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Origin (no path, no trailing slash) of the site that hosts the game
CLIENT_ORIGIN=https://yourname.github.io
# Public URL of THIS server, used for Stripe return pages
PUBLIC_URL=https://dragonwall-api.onrender.com
# Long random string; signs perk entitlements. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENT_SECRET=change-me
CURRENCY=usd
# Put the database on a persistent disk in production
DB_PATH=./dragonwall.db
PORT=3000
